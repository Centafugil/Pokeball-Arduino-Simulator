enum State{
  IDLE,
  READY,
  THROWING,
  SHAKE1,
  SHAKE2,
  SHAKE3,
	WAIT,
  CAUGHT,
  ESCAPED,
  RESULT
};




struct Pokemon{
  
  int spawnThreshold;
  int catchRate;
  int pokemonID;   //pokemonID is 0 to 4
  int rarity; // 0 - common, 1- uncommon , 2 - rare, 3- mythical
};

const Pokemon pokemon [] ={
	{75, 45, 0, 0}, //bidoof: 0 - 74
	{85, 45, 1, 1}, //pikachu: 74 - 85
	{92, 45, 2, 1}, //beldum: 85 - 91
	{97, 45, 3, 3}, //garchomp: 92 - 96
	{100, 45, 4, 3}  //Mewtwo : 97 - 100
};


Pokemon currentPokemon;


unsigned long currentTime;
const uint8_t POKEMON_COUNT = sizeof(pokemon) / sizeof(pokemon[0]);

uint8_t spawnRoll;  //Random value generator variables
uint8_t catchRoll;

bool previousButton = false;
bool currentButton = false;

unsigned long previousFrameTime;
uint8_t shakeFrame = 0;
unsigned long frameDelay = 120;



enum State pokeballState; //default state

void setup(){
  pinMode(4, INPUT_PULLUP);   //button
	display.begin(0x3C, true); 
  Serial.begin(9600);

  randomSeed(analogRead(A0));
	setState(IDLE);

	display.clearDisplay();
	display.setTextColor(SH110X_WHITE);
  display.setTextSize(2);
	staticPokeball();
}



void startingSequence(State newState){

  
  if(currentButton && !previousButton){
          
    Serial.println("pressed");
    pokeballState = newState;  
    previousButton = currentButton;
      
    

  }else if(!currentButton && previousButton){     
    previousButton = false;
  }
	
	
}



void loop(){

  currentButton = !digitalRead(4);
	setState(pokeballState);

}



void setState(State newState){

	pokeballState = newState;

	

	switch (newState){

    case IDLE:
      
			display.clearDisplay();
			idlePokeballAnimation();
			startingSequence(READY);
			Serial.println("IDLE");
			
			break;

    case READY:

      startingSequence(THROWING);
      Serial.println("READY TO THROW");
      
			
			break;

    case THROWING:

     	pokeballState = SHAKE1;
			Serial.println("THROWING");
			
			currentTime = millis();
      break;

    case SHAKE1:
			pokeballShakeAnimation();
      
      Serial.println("SHAKE1");
     
			delayMaker(400, SHAKE2);
			
      break;

    case SHAKE2:
      pokeballShakeAnimation();
			
      Serial.println("SHAKE 2");
			
			delayMaker(400, SHAKE3);
			
      break;
    
    case SHAKE3:
      
			pokeballShakeAnimation();
			
      Serial.println("SHAKE 3");
			
			delayMaker(1000, WAIT);

			break;

		case WAIT:

      spawnRoll = random(101);
      catchRoll = random(101);
			
      currentPokemon = choosePokemon();


      Serial.println("Pokemon:");
      Serial.println(currentPokemon.pokemonID);

		
			

      if(catchRoll < currentPokemon.catchRate){
        pokeballState = CAUGHT;
      }else{
        pokeballState = ESCAPED;
      }
      
      break;

    case CAUGHT:
			caughtPokeballSprite();
      Serial.println("CAUGHT");

      delayMaker(400, RESULT);

     

      break;

    case ESCAPED:
      Serial.println("Escaped");
			escapePokeballSprite();
			display.display();
      Serial.println(catchRoll);
      Serial.println(spawnRoll);
      
      delayMaker(1000, IDLE);
			     
      
      break;

    case RESULT:
      
      switch (currentPokemon.rarity){
        case 0 :

          
					display.println("common");
					display.display();
          break;
        case 1 :

          
          Serial.println("Un common");
          break;
        case 2:

          
          Serial.println("RARE");
          break;
        case 3:

          
          Serial.println("MYTHICAL");
          break;

        

      }

      delayMaker(400, IDLE);
      
      break;
      
      
      
  }
}


Pokemon choosePokemon(){

	spawnRoll = random(100);

	for(int i = 0; i < POKEMON_COUNT; ++i){
		if(spawnRoll < pokemon[i].spawnThreshold)
		{
			return pokemon[i];
		}
	}

	return pokemon[0]; //defensive fallback
}



void pokeballShakeAnimation(){


	if(millis() - previousFrameTime < 120) return;

	previousFrameTime = millis();
	display.clearDisplay();

	if(shakeFrame == 0|| shakeFrame == 3){
		display.drawBitmap(0 , 0, epd_bitmap_3, 128, 64, OLED_COLOR);
	}else if(shakeFrame == 1){
		display.drawBitmap(0, 0, epd_bitmap_4, 128, 64, OLED_COLOR);
	}else{
		display.drawBitmap(0, 0, epd_bitmap_5, 128, 64, OLED_COLOR);
	}

	display.display();

	shakeFrame++;
	
	if(shakeFrame >= 4){
		shakeFrame = 0;
	}
	
	
}

void staticPokeball(){
	display.clearDisplay();
	display.drawBitmap(0, 0, epd_bitmap_3, 128, 64, SH110X_WHITE);
	display.display();
	
}

void escapePokeballSprite(){
	display.clearDisplay();
	display.drawBitmap(0, 0, epd_bitmap_2, 128, 64, SH110X_WHITE);
	display.display();
	
}

void caughtPokeballSprite(){
	display.clearDisplay();
	display.drawBitmap(0, 0, epd_bitmap_1, 128, 64, SH110X_WHITE);
	display.display();
	
}

unsigned long lastTime;
uint8_t FrameCounter = 0;

void idlePokeballAnimation(){
	

	if(millis() - lastTime < 300)return;
	lastTime = millis();
	display.clearDisplay();

	if(FrameCounter == 0){
		display.drawBitmap(0, 0, epd_bitmap_6, 128, 64, SH110X_WHITE);
	}else if(FrameCounter == 1){
		display.drawBitmap(0, 0, epd_bitmap_7, 128, 64, SH110X_WHITE);
	}
	display.display();

	FrameCounter++;

	if(FrameCounter >= 2){
		FrameCounter = 0;
	}


}

void delayMaker(int delay, State state ){
	
	
	if(millis() - currentTime > delay){
		pokeballState = state;
		currentTime = millis();
	}
}